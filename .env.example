# Copy to .env.local (git-ignored) to run against a Supabase project. Leave unset for the in-memory demo.
# All three are needed: the explicit flag stops a platform-provided Supabase URL from switching the app over
# to a database that hasn't had this repo's migrations applied.
VITE_MARKEZLY_BACKEND=supabase
VITE_SUPABASE_URL=
# Publishable (anon) key: public by design, protected by row-level security.
VITE_SUPABASE_PUBLISHABLE_KEY=
# Never put the service-role key, database password or access tokens in any VITE_ variable or in this repo.
