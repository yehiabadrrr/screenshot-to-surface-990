# Copy to .env.local (gitignored) and fill in from Supabase → Project Settings → API.
# Only the URL and the publishable (anon) key belong here. Never put the service-role key,
# database password or access tokens in any env file the app reads.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<publishable-or-anon-key>

# Live RLS suite only (npm run test:rls-live). Use a TEST project and confirmed test users.
# Put real values in .env.test.local (gitignored), not here.
SUPABASE_TEST_URL=
SUPABASE_TEST_PUBLISHABLE_KEY=
SUPABASE_TEST_USER_A_EMAIL=
SUPABASE_TEST_USER_A_PASSWORD=
SUPABASE_TEST_USER_B_EMAIL=
SUPABASE_TEST_USER_B_PASSWORD=
